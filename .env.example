POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Optional source database credentials. Set only the variables referenced by datasource records.
# Keep this file local; never commit your real .env file.
MES_DB_PASSWORD=
ORACLE_DB_PASSWORD=
MYSQL_DB_PASSWORD=
PG_DB_PASSWORD=

# Optional local-only MySQL test container (Docker Compose profile: mysql-test).
# Change both values before starting the test database. Do not reuse production credentials.
MYSQL_TEST_ROOT_PASSWORD=change-this-local-mysql-root-password
MYSQL_TEST_READER_PASSWORD=change-this-local-readonly-password
